<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for the wrong-answer haptic feedback in GuessByMapActivity -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.GeoQuiz">
        <!-- Splash Activity - Loading Screen -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.GeoQuiz">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- First Page Activity -->
        <activity
            android:name=".FirstPageActivity"
            android:exported="false" />
        
        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Daily Country Activity -->
        <activity
            android:name=".DailyCountryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Daily Level Select Activity -->
        <activity
            android:name=".DailyLevelSelectActivity"
            android:exported="false" />

        <!-- Guess by the Map: difficulty selection -->
        <activity
            android:name=".MapDifficultyActivity"
            android:exported="false" />

        <!-- Guess by the Map: level grid for a single difficulty -->
        <activity
            android:name=".MapLevelSelectActivity"
            android:exported="false" />

        <!-- Guess by the Map: main gameplay screen -->
        <activity
            android:name=".GuessByMapActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
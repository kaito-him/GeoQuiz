<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for a purchased-hint row inside the guess RecyclerView.
  Deep amber/gold feel to distinguish it from regular guess cards.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFF3CD" />
    <corners android:radius="12dp" />
    <stroke
        android:width="2dp"
        android:color="#F59E0B" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for the countdown timer badge.
  Starts as wheat (normal) — activity swaps to timer_background_warning
  when time is running low.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F5DEB3" />
    <corners android:radius="20dp" />
    <stroke
        android:width="3dp"
        android:color="#8B4513" />
</shape>

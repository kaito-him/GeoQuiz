<?xml version="1.0" encoding="utf-8"?>
<!--
  A card inserted into the guess RecyclerView after a hint is purchased.
  Visually distinct from country-guess cards: amber/gold border with a
  lightbulb header and the revealed hint text below it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/hint_reveal_background"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <!-- Header: icon + "Hint Revealed" label + slot badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvHintRevealTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:text="@string/hint_revealed"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#7C4700" />

    </LinearLayout>

    <!-- Thin amber divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F59E0B"
        android:layout_marginBottom="8dp" />

    <!-- Hint type name (e.g. "Reveal Capital City") -->
    <TextView
        android:id="@+id/tvHintTypeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hint type"
        android:textSize="12sp"
        android:textColor="#9E6B00"
        android:layout_marginBottom="4dp" />

    <!-- The actual revealed value (large, prominent) -->
    <TextView
        android:id="@+id/tvHintRevealedValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Revealed value"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#3E2723" />

</LinearLayout>

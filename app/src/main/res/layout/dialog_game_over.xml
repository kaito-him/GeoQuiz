<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom game over dialog for Country Quest mode.
  Warm earth-tone theme: cream background, brown text/borders, tan accents.
  Matches the success dialog style.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_success_background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <!-- Close button (X) in top-right corner -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <!-- Title row -->
        <TextView
            android:id="@+id/tvGameOverTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/game_over_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3E2723" />

        <!-- Close button (X) -->
        <TextView
            android:id="@+id/btnGameOverClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end|top"
            android:text="✕"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#8B4513"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

    </FrameLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#C4A882"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp" />

    <!-- Main message -->
    <TextView
        android:id="@+id/tvGameOverMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#5D4037"
        android:layout_marginBottom="10dp" />

    <!-- Country revealed -->
    <TextView
        android:id="@+id/tvGameOverCountry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:layout_marginBottom="16dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#C4A882"
        android:layout_marginBottom="14dp" />

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/btnTryAgain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_try_again"
            android:textColor="#3E2723"
            android:textStyle="bold"
            android:background="@drawable/button_background"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnGiveUp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_give_up"
            android:textColor="#8B4513"
            android:textStyle="bold"
            android:background="@drawable/button_background"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Hint-shop modal dialog.
  Centred floating card — height wraps its content exactly, no extra space.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/hint_modal_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <!-- Header row: title + coin balance + close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hint_shop_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#3E2723" />

        <!-- Coin balance badge: coin image + number -->
        <LinearLayout
            android:id="@+id/layoutCoinBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/coin_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/coin"
                android:scaleType="fitCenter"
                android:layout_marginEnd="4dp"
                android:contentDescription="coins" />

            <TextView
                android:id="@+id/tvDialogCoinBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#3E2723" />

        </LinearLayout>

        <!-- Close button -->
        <TextView
            android:id="@+id/tvDialogClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="✕"
            android:textSize="17sp"
            android:textColor="#3E2723"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close hint shop" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#8B4513"
        android:alpha="0.5"
        android:layout_marginBottom="8dp" />

    <!-- Hint rows injected programmatically — no ScrollView so height wraps exactly -->
    <LinearLayout
        android:id="@+id/layoutDialogHintRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom confirmation dialog for hint purchases.
  Styled to match the cream and brown theme used throughout the app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_success_background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvHintConfirmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/map_hint_confirm_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#C4A882"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <!-- Message with coin icon -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/map_hint_spend"
            android:textSize="15sp"
            android:textColor="#5D4037" />

        <TextView
            android:id="@+id/tvHintConfirmCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginStart="4dp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/coin"
            android:layout_marginStart="4dp"
            android:contentDescription="coin" />

    </LinearLayout>

    <!-- Hint type description -->
    <TextView
        android:id="@+id/tvHintConfirmType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textSize="14sp"
        android:textColor="#5D4037"
        android:gravity="center"
        android:layout_marginBottom="18dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#C4A882"
        android:layout_marginBottom="14dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- Cancel button -->
        <Button
            android:id="@+id/btnHintConfirmCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/map_hint_cancel"
            android:textColor="#8B4513"
            android:textStyle="bold"
            android:background="@drawable/button_hint_cancel"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="10dp" />

        <!-- Buy button -->
        <Button
            android:id="@+id/btnHintConfirmBuy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/map_hint_buy"
            android:textColor="#FFF8E7"
            android:textStyle="bold"
            android:background="@drawable/button_hint_buy"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

    </LinearLayout>

</LinearLayout>

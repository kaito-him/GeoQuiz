<?xml version="1.0" encoding="utf-8"?>
<!--
  Confirmation dialog for giving up.
  Styled to match the cream and brown theme.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_success_background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvGiveUpTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/give_up_confirm_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#C4A882"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/tvGiveUpMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/give_up_confirm_message"
        android:textSize="15sp"
        android:textColor="#5D4037"
        android:gravity="start"
        android:layout_marginBottom="18dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#C4A882"
        android:layout_marginBottom="14dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- Keep Playing button -->
        <Button
            android:id="@+id/btnGiveUpCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/give_up_confirm_no"
            android:textColor="#8B4513"
            android:textStyle="bold"
            android:background="#F4E2C8"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="10dp" />

        <!-- Give Up button -->
        <Button
            android:id="@+id/btnGiveUpConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/give_up_confirm_yes"
            android:textColor="#8B4513"
            android:textStyle="bold"
            android:background="#F4E2C8"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

    </LinearLayout>

</LinearLayout>

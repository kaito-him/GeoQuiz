<?xml version="1.0" encoding="utf-8"?>
<!--
  A single row inside the Hints panel.
  Three visual states:
    1. AVAILABLE   — tan background, enabled, shows coin price
    2. DISABLED    — grey background, not clickable, shows reason
    3. REVEALED    — green background, not clickable, shows the revealed value
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hintRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/button_background"
    android:clickable="true"
    android:focusable="true">

    <!-- Left: hint label and optional disabled reason / revealed text -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHintLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hint Name"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#3E2723" />

        <!-- Secondary line: disabled reason or revealed value -->
        <TextView
            android:id="@+id/tvHintSubtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#5D4037"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Right: price badge with coin image + number -->
    <LinearLayout
        android:id="@+id/layoutHintPriceBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/coin_background"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginStart="8dp">

        <ImageView
            android:id="@+id/ivHintCoinIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/coin"
            android:scaleType="fitCenter"
            android:layout_marginEnd="3dp"
            android:contentDescription="coin" />

        <TextView
            android:id="@+id/tvHintPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20"
            android:textSize="13sp"
            android:textColor="#3E2723"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
